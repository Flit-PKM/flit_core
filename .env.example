# Environment (allowed: development | production | test)
# development — local work; SQL echo on; verbose errors/validation bodies; sync compare debug logs;
#               PUBLIC_BASE_URL defaults to http://127.0.0.1:8000 if unset
# production  — live deploy; PUBLIC_BASE_URL required; 500 responses hide internal details
# test        — pytest/CI; PUBLIC_BASE_URL defaults to http://testserver if unset (set in tests)
ENVIRONMENT=development

# Security - REQUIRED: Must be at least 32 characters long (no default; must be set)
SECRET_KEY=your-secret-key-here-change-in-production-minimum-32-characters

# Logging
LOG_LEVEL=INFO
# LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Database backend: postgres (default) or d1 (Cloudflare D1)
DB_BACKEND=postgres

# PostgreSQL (required when DB_BACKEND=postgres)
# Alternative for Render and similar hosts: set DATABASE_URL instead; then DB_USER, DB_PASSWORD, DB_HOST, DB_PORT, DB_NAME are optional
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Samples below for local .env; default when unset: DB_USER/DB_PASSWORD/DB_NAME=none (required unless DATABASE_URL is set)
DB_USER=youruser
DB_PASSWORD=my@super#secure!pw
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flit

# Cloudflare D1 (required when DB_BACKEND=d1)
# CF_ACCOUNT_ID=your-cloudflare-account-id
# CF_API_TOKEN=your-d1-api-token
# CF_DATABASE_ID=your-d1-database-uuid

# Database Connection Pool (optional, PostgreSQL only; defaults shown)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# CORS Origins (optional). Comma-separated or JSON array — Flit web app and /api only.
# default when unset: http://localhost:5173
# Browser MCP clients (/mcp, MCP OAuth well-known) do not need entries here when MCP_ENABLED=true
# (see MCP_CORS_REFLECT_ORIGIN). Native/desktop MCP hosts are not subject to CORS.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Webapp build directory (optional). Path relative to project root.
# Copy or symlink frontend build output here.
# WEBAPP_BUILD_DIR=webapp_build

# JWT Settings (optional, defaults shown)
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Sign-In (optional; when unset, POST /auth/login-google returns 503)
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Token settings (optional, defaults shown)
# OAUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
# OAUTH_REFRESH_TOKEN_EXPIRE_DAYS=1825  # default when unset: 90

# App list override (optional). JSON array of {"slug","name"}.
# default when unset: [{"slug":"flit","name":"Flit"},{"slug":"still","name":"Still"},{"slug":"mcp","name":"MCP Agent"}]
# ALLOWED_APPS_JSON=[{"slug":"flit","name":"Flit"},{"slug":"still","name":"Still"}]

# Rate limiting for public auth routes (slowapi). Set false for local load tests.
# RATE_LIMIT_AUTH_ENABLED=true

# MCP server for external agents (Grok, etc.)
# MCP_ENABLED=false
# MCP_CORS_REFLECT_ORIGIN=true
# MCP_OPENAPI_INCLUDE=true
# MCP_GOOGLE_OAUTH_CLIENT_ID=...
# MCP_GOOGLE_OAUTH_CLIENT_SECRET=...
# MCP_ACCESS_TOKEN_EXPIRE_MINUTES=60
# MCP_REFRESH_TOKEN_EXPIRE_DAYS=90
# MCP_OAUTH_DCR_ENABLED=false
# MCP_OAUTH_DCR_DYNAMIC_CLIENT_ID=dynamic
# MCP_RATE_LIMIT_ENABLED=true
# MCP_RATE_LIMIT=120/minute
# MCP_OAUTH_CIMD_ENABLED=true
# MCP_OAUTH_CIMD_ALLOWED_HOST_SUFFIXES=x.ai,cursor.sh  # default when unset: (empty) — any HTTPS host

# Connection code flow (optional, defaults shown)
# CONNECTION_CODE_EXPIRE_MINUTES=10
# CONNECTION_CODE_LENGTH=8

# Cloudflare Turnstile (optional; required for POST /subscriptions, POST /auth/register, POST /password-reset/request when set)
# TURNSTILE_SECRET=your-turnstile-secret-key

# Dodo Payments (optional; required for billing checkout and webhooks)
# DODO_PAYMENTS_API_KEY=your-dodo-api-key
# DODO_PAYMENTS_WEBHOOK_SECRET=your-webhook-signing-secret
# DODO_PAYMENTS_ENVIRONMENT=test
# Optional: used for is_billing_configured when the plan IDs below are not set.
# DODO_PAYMENTS_SUBSCRIPTION_PRODUCT_ID=your-subscription-product-id
# Monthly and annual subscription products. Get IDs from Dodo dashboard.
# DODO_PAYMENTS_MONTHLY=your-monthly-product-id
# DODO_PAYMENTS_ANNUAL=your-annual-product-id

# Postmark SMTP (optional; when unset, email sending is disabled)
# POSTMARK_SMTP_TOKEN=your-server-api-token
# POSTMARK_SMTP_FROM_EMAIL=noreply@yourdomain.com
# POSTMARK_SMTP_FROM_NAME=Flit  # default when unset: none (no display name)
# POSTMARK_SMTP_HOST=smtp.postmarkapp.com
# POSTMARK_SMTP_PORT=2525

# Canonical public URL (email links, MCP OAuth issuer, verify/reset redirects).
# Required when ENVIRONMENT=production. In development, defaults to http://127.0.0.1:8000 if unset.
# PUBLIC_BASE_URL=https://core.flit-pkm.com
# VERIFY_EMAIL_EXPIRE_HOURS=24
# VERIFY_EMAIL_RESEND_COOLDOWN_MINUTES=5

# Password reset (redirects use PUBLIC_BASE_URL)
# PASSWORD_RESET_EXPIRE_HOURS=1
# PASSWORD_RESET_COOLDOWN_MINUTES=5
